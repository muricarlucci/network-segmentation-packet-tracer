! ==============================================================================
! ATIVO: HQ-Core-3650 (Switch Multicamada L3 - Sede SP)
! FUNÇÃO: Roteamento Inter-VLAN (ASIC), SVI Gateways, DHCP Core, OSPF Backbone
! ==============================================================================
version 15.0
no service timestamps log datetime msec
service password-encryption
!
hostname HQ-Core-3650
!
no enable password
enable secret cisco
!
ip routing
!
vlan 10
 name SEC_OPERATIONS
vlan 20
 name FINANCIAL_CORE
vlan 30
 name ANALYTICS_DATA
vlan 40
 name AUDIT_COMPLIANCE
vlan 99
 name MGMT_HARDENING
vlan 200
 name TRANSIT_L3_WAN
!
! --- GATEWAYS SVI DE ALTA CAPACIDADE (/22 E /30) ---
interface Vlan10
 description GW_SOC_NOC
 ip address 172.16.0.1 255.255.252.0
 no shutdown
!
interface Vlan20
 description GW_FINANCIAL_CORE
 ip address 172.16.4.1 255.255.252.0
 no shutdown
!
interface Vlan30
 description GW_MARKET_ANALYTICS
 ip address 172.16.8.1 255.255.252.0
 no shutdown
!
interface Vlan40
 description GW_AUDIT_COMPLIANCE
 ip address 172.16.12.1 255.255.252.0
 no shutdown
!
interface Vlan99
 description GW_SWITCH_MANAGEMENT
 ip address 172.16.99.1 255.255.255.0
 no shutdown
!
interface Vlan200
 description TRANSIT_L3_ROUTER_EDGE
 ip address 172.16.16.1 255.255.255.252
 no shutdown
!
! --- SERVIDOR DHCP NATIVO COM EXCLUSÃO DE INFRAESTRUTURA ---
ip dhcp excluded-address 172.16.0.1 172.16.0.50
ip dhcp excluded-address 172.16.4.1 172.16.4.50
ip dhcp excluded-address 172.16.8.1 172.16.8.50
ip dhcp excluded-address 172.16.12.1 172.16.12.50
!
ip dhcp pool POOL_SEC_OPS
 network 172.16.0.0 255.255.252.0
 default-router 172.16.0.1
 dns-server 172.16.32.10
!
ip dhcp pool POOL_FINANCIAL
 network 172.16.4.0 255.255.252.0
 default-router 172.16.4.1
 dns-server 172.16.32.10
!
ip dhcp pool POOL_ANALYTICS
 network 172.16.8.0 255.255.252.0
 default-router 172.16.8.1
 dns-server 172.16.32.10
!
ip dhcp pool POOL_AUDIT
 network 172.16.12.0 255.255.252.0
 default-router 172.16.12.1
 dns-server 172.16.32.10
!
! --- INTERFACES FÍSICAS ---
interface GigabitEthernet1/0/1
 description TRUNK_UPLINK_HQ_ACCESS_2960
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,99
 switchport nonegotiate
 no shutdown
!
interface GigabitEthernet1/0/2
 description LINK_TRANSITO_L3_EDGE_ROUTER
 switchport mode access
 switchport access vlan 200
 no shutdown
!
! --- ROTEAMENTO OSPF AREA 0 ---
router ospf 1
 router-id 1.1.1.1
 network 172.16.0.0 0.0.3.255 area 0
 network 172.16.4.0 0.0.3.255 area 0
 network 172.16.8.0 0.0.3.255 area 0
 network 172.16.12.0 0.0.3.255 area 0
 network 172.16.99.0 0.0.0.255 area 0
 network 172.16.16.0 0.0.0.3 area 0
!
! --- BASELINE DE HARDENING SSHv2 ---
ip domain-name anbima.corp
crypto key generate rsa modulus 2048
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 4
username ADMIN privilege 15 secret ANBIMA@SEC2026!
!
line vty 0 4
 login local
 transport input ssh
!
end
