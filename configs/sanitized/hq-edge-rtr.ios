ENABLE
CONF T
HOSTNAME HQ-Edge-RTR
NO ENABLE PASSWORD
ENABLE SECRET CISCO

! 1. ENLACE L3 COM O SWITCH CORE (VLAN 200)
INT G0/0
DESCRIPTION LINK_TRANSITO_L3_CORE_3650
IP ADDRESS 172.16.16.2 255.255.255.252
NO SHUT
EXIT

! 2. INTERFACES SERIAIS (PADRAO FIAP)
! WAN 1 -> Vai para Filial RJ (Porta 0 = DCE com Clock)
INT S0/3/0
DESCRIPTION WAN1_BRANCH_RJ
IP ADDRESS 10.0.0.1 255.255.255.252
CLOCK RATE 64000
NO SHUT
EXIT

! WAN 3 -> Vem do CPD Datacenter (Porta 1 = DTE sem Clock)
INT S0/3/1
DESCRIPTION WAN3_CPD_DATACENTER
IP ADDRESS 10.0.0.10 255.255.255.252
NO SHUT
EXIT

! 3. OSPF COM REDISTRIBUICAO BGP
ROUTER OSPF 1
ROUTER-ID 2.2.2.2
NETWORK 172.16.16.0 0.0.0.3 AREA 0
NETWORK 10.0.0.0 0.0.0.3 AREA 0
REDISTRIBUTE BGP 65001 SUBNETS
EXIT

! 4. BGP EXTERNO (PEERING COM CPD NO IP 10.0.0.9)
ROUTER BGP 65001
BGP LOG-NEIGHBOR-CHANGES
NEIGHBOR 10.0.0.9 REMOTE-AS 65002
REDISTRIBUTE OSPF 1
EXIT

! 5. HARDENING SSHv2
IP DOMAIN-NAME ANBIMA.CORP
CRYPTO KEY GENERATE RSA
2048
IP SSH VERSION 2
USERNAME ADMIN PRIVILEGE 15 SECRET ANBIMA@SEC2026!
LINE VTY 0 4
LOGIN LOCAL
TRANSPORT INPUT SSH
IP SSH TIME-OUT 60
IP SSH AUTHENTICATION-RETRIES 4
EXIT
